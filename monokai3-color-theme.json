  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#7a797a"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#ff6e92"
      }
    },
    {
      "name": "Built-in constant",
      "scope": ["constant.language", "variable.language"],
      "settings": {
        "foreground": "#ff6e92"
      }
    },
    {
      "name": "User-defined constant",
      "scope": ["constant", "constant.numeric", "constant.character"],
      "settings": {
        "foreground": "#fca073"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other", "meta.objectliteral"],
      "settings": {
        "foreground": "#fcfcfa"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.template", "punctuation.definition.string"],
      "settings": {
        "foreground": "#ffdb72"
      }
    },
    {
      "name": "String escape / regex",
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": {
        "foreground": "#83dfea"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation"],
      "settings": {
        "foreground": "#c5c4c4"
      }
    },
    {
      "name": "Function",
      "scope": ["support.function", "entity.name.function", "meta.function-call"],
      "settings": {
        "foreground": "#b2a5f3"
      }
    },
    {
      "name": "Type",
      "scope": ["support.type", "entity.name.type", "entity.name.class", "entity.other.inherited-class", "meta.class"],
      "settings": {
        "foreground": "#83dfea"
      }
    },
    {
      "name": "Class name",
      "scope": ["entity.name.class", "entity.other.inherited-class"],
      "settings": {
        "foreground": "#83dfea"
      }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language.boolean"],
      "settings": {
        "foreground": "#ff6e92"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#ff6e92"
      }
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#b2a5f3"
      }
    },
    {
      "name": "Library function",
      "scope": ["support.function"],
      "settings": {
        "foreground": "#b2a5f3"
      }
    },
    {
      "name": "Library constant",
      "scope": ["support.constant"],
      "settings": {
        "foreground": "#fca073"
      }
    },
    {
      "name": "Library class / type",
      "scope": ["support.type", "support.class"],
      "settings": {
        "foreground": "#83dfea"
      }
    },
    {
      "name": "Library class",
      "scope": ["support.class"],
      "settings": {
        "foreground": "#83dfea"
      }
    },
    {
      "name": "Meta tag",
      "scope": ["meta.tag", "declaration"],
      "settings": {
        "foreground": "#ff6e92"
      }
    },
    {
      "name": "Delimiter",
      "scope": ["punctuation.definition.list", "punctuation.definition.dictionary"],
      "settings": {
        "foreground": "#c5c4c4"
      }
    },
    {
      "name": "CSS - Property",
      "scope": ["source.css entity.name.tag", "source.sass", "source.scss", "source.less", "source.stylus"],
      "settings": {
        "foreground": "#83dfea"
      }
    },
    {
      "name": "CSS - Class",
      "scope": ["source.css entity.other.attribute-name.class", "source.sass entity.other.attribute-name.class", "source.scss entity.other.attribute-name.class"],
      "settings": {
        "foreground": "#83dfea"
      }
    },
    {
      "name": "CSS - ID",
      "scope": ["source.css entity.other.attribute-name.id"],
      "settings": {
        "foreground": "#b2a5f3"
      }
    },
    {
      "name": "CSS - Selector",
      "scope": ["source.css meta.selector"],
      "settings": {
        "foreground": "#83dfea"
      }
    },
    {
      "name": "JSON - Key",
      "scope": ["source.json meta.mapping.key string"],
      "settings": {
        "foreground": "#ff6e92"
      }
    },
    {
      "name": "JSON - String value",
      "scope": ["source.json meta.mapping.value string"],
      "settings": {
        "foreground": "#ffdb72"
      }
    },
    {
      "name": "YAML - Key",
      "scope": ["source.yaml meta.mapping.key string"],
      "settings": {
        "foreground": "#ff6e92"
      }
    },
    {
      "name": "Markdown - Header",
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#ff6e92",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#b2a5f3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#b2a5f3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Bold italic",
      "scope": ["markup.bold markup.italic", "markup.italic markup.bold"],
      "settings": {
        "foreground": "#b2a5f3",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Markdown - Blockquote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#7a797a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Link",
      "scope": ["markup.underline.link", "markup.inline.raw.string"],
      "settings": {
        "foreground": "#83dfea"
      }
    },
    {
      "name": "Markdown - List",
      "scope": ["markup.list"],
      "settings": {
        "foreground": "#ff6e92"
      }
    },
    {
      "name": "Markdown - Code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#fca073"
      }
    },
    {
      "name": "Markdown - Horizontal Rule",
      "scope": ["markup.separator"],
      "settings": {
        "foreground": "#656366"
      }
    },
    {
      "name": "Diff - Inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#b0df81"
      }
    },
    {
      "name": "Diff - Deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#ff6e92"
      }
    },
    {
      "name": "Diff - Changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#fca073"
      }
    },
    {
      "name": "Diff - Header",
      "scope": ["meta.diff.header", "meta.diff.range"],
      "settings": {
        "foreground": "#7a797a"
      }
    }
  ]
}
